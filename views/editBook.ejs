<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update <%= book.name %> | Books</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="flex min-h-screen flex-col bg-gray-50">
    <%- include('includes/nav.ejs') %>

    <main class="w-full max-w-3xl flex-1 self-center p-6">
        <h1 class="mb-6 text-3xl font-bold">Update book</h1>

        <% if (error) { %>
            <p class="mb-4 text-red-700" role="alert"><%= error %></p>
        <% } %>

        <form action="/books/<%= book._id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-5">
            <div>
                <label for="name" class="mb-1 block font-medium">Book name</label>
                <input id="name" name="name" type="text" required value="<%= book.name || '' %>" class="w-full rounded border border-gray-300 bg-white p-2">
            </div>

            <div>
                <label for="year" class="mb-1 block font-medium">Date / year</label>
                <input id="year" name="year" type="text" value="<%= book.year || '' %>" class="w-full rounded border border-gray-300 bg-white p-2">
            </div>

            <div>
                <label for="description" class="mb-1 block font-medium">Description</label>
                <textarea id="description" name="description" rows="6" class="w-full rounded border border-gray-300 bg-white p-2"><%= book.description || '' %></textarea>
            </div>

            <fieldset>
                <legend class="mb-2 font-medium">Categories</legend>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    <% categories.forEach(category => { %>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="categories" value="<%= category %>" <%= (book.categories || []).includes(category) ? 'checked' : '' %>>
                            <%= category %>
                        </label>
                    <% }) %>
                </div>
            </fieldset>

            <div>
                <% if (book.image) { %>
                    <img src="<%= book.image %>" alt="Current cover for <%= book.name %>" class="mb-3 h-48 w-32 rounded border object-cover">
                <% } %>
                <label for="image" class="mb-1 block font-medium">Choose a new cover image</label>
                <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="block w-full text-sm">
                <p class="mt-1 text-sm text-gray-600">JPG, PNG, WebP, or GIF; up to 5 MB.</p>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">Save changes</button>
                <a href="/books" class="rounded border border-gray-300 bg-white px-4 py-2">Cancel</a>
            </div>
        </form>
    </main>

    <%- include('includes/footer.ejs') %>
</body>
</html>
