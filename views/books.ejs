
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OpenLibrary | Books</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css"
        crossorigin="anonymous"
        referrerpolicy="no-referrer">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }

        .search-button {
            transition: all 0.3s ease;
        }

        .search-button:hover {
            background-color: #c45b2b;
            transform: translateY(-1px);
        }

        .book-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 35px rgba(65, 40, 25, 0.12);
        }

        .book-cover {
            transition: transform 0.4s ease;
        }

        .book-card:hover .book-cover {
            transform: scale(1.03);
        }

        .bookmark-icon {
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .bookmark-icon:hover {
            transform: scale(1.15);
        }
    </style>
</head>

<body class="flex min-h-screen flex-col bg-[#faf7f2] text-[#33251e]">

    <!-- Navbar -->
    <%- include('includes/nav.ejs') %>

    <main class="flex-1">

        <!-- Page Heading -->
        <section class="px-5 pt-10 sm:px-8 lg:px-12">

            <div class="mx-auto max-w-7xl">

                <div class="relative overflow-hidden rounded-3xl bg-[#493024] px-6 py-9 sm:px-10 sm:py-12">

                    <div class="pointer-events-none absolute -right-12 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
                    <div class="pointer-events-none absolute -right-4 -top-12 h-44 w-44 rounded-full border border-white/10"></div>

                    <div class="relative">
                        <p class="text-xs font-bold tracking-[3px] text-[#f2b47e] uppercase">
                            YOUR PERSONAL BOOK COLLECTION
                        </p>

                        <h1 class="mt-3 text-4xl font-bold text-[#fff8ee] sm:text-5xl">
                            Discover Your Next
                            <span class="text-[#e9a66b]">Favourite Book.</span>
                        </h1>

                        <p class="mt-4 max-w-2xl text-sm leading-7 text-[#e4d5c9] sm:text-base">
                            Explore fascinating stories, discover new authors,
                            and find books that inspire your imagination.
                            Your next reading adventure begins here.
                        </p>

                        <div class="mt-6 flex items-center gap-3 text-sm text-[#f2d8c3]">
                            <i class="fa-solid fa-book-open text-[#e9a66b]"></i>
                            <span>Search, explore and bookmark books you love.</span>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <!-- Books Section -->
        <section class="px-5 py-9 sm:px-8 lg:px-12">

            <div class="mx-auto max-w-7xl rounded-3xl border border-[#eadbca] bg-white/80 p-5 shadow-sm sm:p-8">

                <!-- Section Heading -->
                <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">

                    <div>
                        <p class="text-xs font-bold tracking-[2px] text-[#bd6a3c] uppercase">
                            THE BOOKSHELF
                        </p>

                        <h2 class="mt-2 text-3xl font-bold text-[#33251e]">
                            Explore Books
                        </h2>

                        <p class="mt-2 text-sm text-[#82736a]">
                            Find your next great read from our collection.
                        </p>
                    </div>

                    <div class="flex items-center gap-2 text-sm font-medium text-[#8c7566]">
                        <i class="fa-solid fa-bookmark text-[#c46b38]"></i>
                        <span>Save your favourite reads</span>
                    </div>

                </div>

                <!-- Search Form -->
                <form action="/books" method="GET"
                    class="mt-7 flex w-full flex-col gap-3 sm:flex-row">

                    <div class="relative flex-1">

                        <i class="fa-solid fa-magnifying-glass absolute top-1/2 left-4 -translate-y-1/2 text-[#a38b79]"></i>

                        <input
                            type="text"
                            name="search"
                            value="<%= typeof search !== 'undefined' ? search : '' %>"
                            placeholder="Search by book title..."
                            aria-label="Search books"
                            class="w-full rounded-xl border border-[#e5d5c5] bg-[#faf7f2] py-3.5 pr-4 pl-11 text-sm text-[#33251e] outline-none transition placeholder:text-[#a38b79] focus:border-[#c46b38] focus:ring-4 focus:ring-[#c46b38]/10"
                        >

                    </div>

                    <button
                        type="submit"
                        class="search-button inline-flex items-center justify-center gap-2 rounded-xl bg-[#df793e] px-7 py-3.5 font-semibold text-white shadow-sm">

                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search Books

                    </button>

                </form>

                <!-- Search Hint -->
                <p class="mt-3 text-xs text-[#938174]">
                    <i class="fa-regular fa-lightbulb mr-1 text-[#c46b38]"></i>
                    Tip: Double-click a book card to open its details.
                </p>

                <!-- Messages -->
                <div class="mt-4">
                    <%- include('includes/messages.ejs') %>
                </div>

                <!-- Book Cards -->
                <div class="mt-7 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

                    <% if (books.length === 0) { %>

                        <div class="col-span-full rounded-2xl border border-dashed border-[#dfcbb8] bg-[#faf7f2] px-5 py-14 text-center">

                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#f2e8dc] text-[#b7774d]">
                                <i class="fa-solid fa-book-open text-2xl"></i>
                            </div>

                            <h3 class="mt-5 text-2xl font-bold text-[#493024]">
                                No Books Found
                            </h3>

                            <p class="mt-2 text-sm text-[#82736a]">
                                We couldn't find any books. Try another search.
                            </p>

                            <a href="/books"
                                class="mt-5 inline-flex items-center gap-2 rounded-xl bg-[#493024] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#68432d]">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                View All Books
                            </a>

                        </div>

                    <% } else { %>

                        <% books.forEach(book => { %>

                            <article
                                class="book-card overflow-hidden rounded-2xl border border-[#eee2d5] bg-white shadow-sm"
                                data-id="<%= book.openLibraryId || book.id || book._id %>">

                                <!-- Book Image -->
                                <div class="relative overflow-hidden bg-[#f2e8dc]">

                                    <% if (book.image) { %>

                                        <img
                                            class="book-cover h-64 w-full object-contain p-4"
                                            src="<%= book.image %>"
                                            alt="<%= book.name %>"
                                            loading="lazy"
                                        >

                                    <% } else { %>

                                        <div class="flex h-64 flex-col items-center justify-center text-[#b39a84]">
                                            <i class="fa-solid fa-book-open text-5xl"></i>
                                            <p class="mt-3 text-sm">Cover unavailable</p>
                                        </div>

                                    <% } %>

                                    <!-- Bookmark Icon -->
                                    <%
                                        const bookmarkStatus = book.isBookmarked ? 'fa-solid' : 'fa-regular';
                                        const bookmarkColor = book.isBookmarked ? 'text-[#c46b38]' : 'text-[#9b8878]';
                                    %>

                                    <button
                                        type="button"
                                        class="bookmark-button absolute top-3 right-3 flex h-10 w-10 items-center justify-center rounded-full border border-[#eadbca] bg-white/95 shadow-sm transition hover:scale-110 hover:bg-[#fff1e5]"
                                        aria-label="<%= book.isBookmarked ? 'Remove bookmark' : 'Bookmark book' %>"
                                        title="<%= book.isBookmarked ? 'Remove bookmark' : 'Bookmark book' %>">

                                        <i class="<%= bookmarkStatus %> fa-bookmark bookmark-icon text-lg <%= bookmarkColor %>"></i>

                                    </button>

                                </div>

                                <!-- Book Information -->
                                <div class="flex h-full flex-col p-5">

                                    <div class="flex items-start justify-between gap-3">

                                        <h2 class="line-clamp-2 text-xl leading-snug font-bold text-[#493024]">
                                            <%= book.name %>
                                        </h2>

                                    </div>

                                    <p class="mt-3 flex items-center gap-2 text-sm font-medium text-[#a17a5d]">
                                        <i class="fa-regular fa-calendar"></i>
                                        <%= book.year || 'Year unavailable' %>
                                    </p>

                                    <%
                                        const descriptionText =
                                            typeof book.description === 'string'
                                                ? book.description.trim()
                                                : '';

                                        const shortDescription =
                                            descriptionText.length > 120
                                                ? descriptionText.substring(0, 120) + '...'
                                                : descriptionText;
                                    %>

                                    <p class="mt-4 min-h-[72px] text-sm leading-6 text-[#82736a]">
                                        <%= shortDescription || 'No description available for this book.' %>
                                    </p>

                                    <!-- Categories -->
                                    <div class="mt-4 border-t border-[#f0e6dc] pt-4">

                                        <p class="mb-2 text-xs font-bold tracking-wide text-[#8c7566] uppercase">
                                            <i class="fa-solid fa-tags mr-1 text-[#c46b38]"></i>
                                            Categories
                                        </p>

                                        <% if (book.categories && book.categories.length > 0) { %>

                                            <div class="flex flex-wrap gap-2">

                                                <% book.categories.forEach(category => { %>

                                                    <span class="rounded-full border border-[#eadbca] bg-[#faf3eb] px-3 py-1 text-xs font-medium text-[#79543c]">
                                                        <%= category %>
                                                    </span>

                                                <% }) %>

                                            </div>

                                        <% } else { %>

                                            <span class="text-sm text-[#a38b79]">
                                                No categories available
                                            </span>

                                        <% } %>

                                    </div>

                                    <form action="/cart/add" method="POST" class="mt-5">
                                        <input type="hidden" name="bookId" value="<%= book.openLibraryId || book.id || book._id %>">
                                        <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#df793e] px-4 py-2.5 text-sm font-bold text-white transition hover:bg-[#c45b2b]">
                                            <i class="fa-solid fa-cart-plus"></i>
                                            Add to cart
                                        </button>
                                    </form>

                                    <!-- Admin Actions -->
                                    <% if (fromDatabase) { %>

                                        <% if (isadmin) { %>

                                            <div class="admin-actions mt-5 flex flex-wrap gap-2 border-t border-[#f0e6dc] pt-4">

                                                <a
                                                    href="/books/<%= book._id %>/edit"
                                                    class="inline-flex items-center gap-2 rounded-lg bg-[#493024] px-3 py-2 text-sm font-semibold text-white transition hover:bg-[#68432d]">

                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                    Update

                                                </a>

                                                <form
                                                    action="/books/<%= book._id %>/delete"
                                                    method="POST"
                                                    class="delete-book-form">

                                                    <button
                                                        type="submit"
                                                        class="inline-flex items-center gap-2 rounded-lg border border-[#f0c9c0] bg-[#fff3f0] px-3 py-2 text-sm font-semibold text-[#b34335] transition hover:bg-[#ffe4de]">

                                                        <i class="fa-solid fa-trash"></i>
                                                        Delete

                                                    </button>

                                                </form>

                                            </div>

                                        <% } %>

                                    <% } %>

                                </div>

                            </article>

                        <% }) %>

                    <% } %>

                </div>

            </div>

        </section>

    </main>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

    <!-- JavaScript -->
    <script>

        // Confirm before deleting a book
        document.querySelectorAll('.delete-book-form').forEach(form => {

            form.addEventListener('submit', event => {

                if (!confirm('Are you sure you want to delete this book?')) {
                    event.preventDefault();
                }

            });

        });


        // Open book details on double-click
        document.querySelectorAll('.book-card').forEach(card => {

            card.addEventListener('dblclick', event => {

                if (event.target.closest('button, a, form, .admin-actions')) {
                    return;
                }

                const rawId = card.dataset.id;

                if (!rawId) {
                    return;
                }

                const bookId = rawId.replace('/works/', '');

                window.location.href =
                    '/books/' + encodeURIComponent(bookId);

            });

        });


        // Bookmark toggle
        document.querySelectorAll('.bookmark-button').forEach(button => {

            button.addEventListener('click', async event => {

                event.preventDefault();
                event.stopPropagation();

                const card = button.closest('.book-card');
                const bookmarkIcon = button.querySelector('.bookmark-icon');

                if (!card || button.disabled) {
                    return;
                }

                const rawId = card.dataset.id;

                if (!rawId) {
                    alert('Book ID is missing.');
                    return;
                }

                const bookId = rawId.replace('/works/', '');

                button.disabled = true;

                try {

                    const response = await fetch(
                        '/books/bookmark/' + encodeURIComponent(bookId),
                        {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            }
                        }
                    );

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(data.message || 'Bookmark failed.');
                    }

                    if (data.isBookmarked) {

                        bookmarkIcon.classList.remove(
                            'fa-regular',
                            'text-[#9b8878]'
                        );

                        bookmarkIcon.classList.add(
                            'fa-solid',
                            'text-[#c46b38]'
                        );

                        button.setAttribute('aria-label', 'Remove bookmark');
                        button.setAttribute('title', 'Remove bookmark');

                    } else {

                        bookmarkIcon.classList.remove(
                            'fa-solid',
                            'text-[#c46b38]'
                        );

                        bookmarkIcon.classList.add(
                            'fa-regular',
                            'text-[#9b8878]'
                        );

                        button.setAttribute('aria-label', 'Bookmark book');
                        button.setAttribute('title', 'Bookmark book');

                    }

                } catch (error) {

                    console.error('Bookmark error:', error);
                    alert(error.message || 'Unable to update bookmark.');

                } finally {

                    button.disabled = false;

                }

            });

        });

    </script>

</body>
</html>
